from sklearn.feature_extraction.text import CountVectorizer, TfidfVectorizer

1. Three short texts
texts = [
    "Artificial intelligence helps computers learn from data.",
    "Machine learning improves predictions using data.",
    "Artificial intelligence and machine learning automate tasks."
]

2. Bag of Words representation
count_vectorizer = CountVectorizer()
bow_matrix = count_vectorizer.fit_transform(texts)

print("Bag of Words Feature Names:")
print(count_vectorizer.get_feature_names_out())

print("\nBag of Words Matrix:")
print(bow_matrix.toarray())

3. TF-IDF calculation
tfidf_vectorizer = TfidfVectorizer()
tfidf_matrix = tfidf_vectorizer.fit_transform(texts)

feature_names = tfidf_vectorizer.get_feature_names_out()

print("\nTF-IDF Matrix:")
print(tfidf_matrix.toarray().round(3))

4. Top 3 keywords from each text
print("\nTop 3 TF-IDF Keywords:")
for i, row in enumerate(tfidf_matrix.toarray()):
    top_indices = row.argsort()[::-1][:3]
    keywords = [
        (feature_names[j], round(row[j], 3))
        for j in top_indices
        if row[j] > 0
    ]
    print(f"Text {i + 1}: {keywords}")

Q4.

1. Two texts describing different technologies
text1 = "
Artificial intelligence enables computers to learn from data.
AI systems recognize patterns and make predictions.
Artificial intelligence is used in healthcare and education.
AI can automate repetitive tasks and support decisions.
"

text2 = "
Blockchain stores information in linked digital blocks.
Blockchain networks can provide transparency and security.
Digital transactions can be recorded on a blockchain.
Blockchain technology is used in finance and supply chains.
"

2. Preprocess and tokenize
def preprocess(text):
    text = text.lower()
    return re.findall(r'\b[a-z]+\b', text)

tokens1 = preprocess(text1)
tokens2 = preprocess(text2)

print("Tokens in Text 1:")
print(tokens1)

print("\nTokens in Text 2:")
print(tokens2)

3a. Jaccard similarity using sets
set1 = set(tokens1)
set2 = set(tokens2)

intersection = set1.intersection(set2)
union = set1.union(set2)

jaccard = len(intersection) / len(union)

print("\nCommon Words:")
print(intersection)

print("Jaccard Similarity:", round(jaccard, 3))

3b. Cosine similarity using TF-IDF
vectorizer = TfidfVectorizer()
tfidf_matrix = vectorizer.fit_transform([text1, text2])

cosine = cosine_similarity(
    tfidf_matrix[0:1], tfidf_matrix[1:2]
)[0][0]

print("Cosine Similarity:", round(cosine, 3))

4. Compare the two metrics
print("\nAnalysis:")
print("Jaccard measures overlap between unique words.")
print("Cosine measures similarity between TF-IDF vectors.")

