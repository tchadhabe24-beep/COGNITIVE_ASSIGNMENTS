from collections import Counter, defaultdict
from nltk.stem import PorterStemmer, LancasterStemmer, RegexpStemmer, WordNetLemmatizer
from nltk.corpus import wordnet

porter, lancaster = PorterStemmer(), LancasterStemmer()
regex = RegexpStemmer(r"ing$|ed$|s$", min=4)     # rule chosen from the data (see below)
lemmatizer = WordNetLemmatizer()

def wn_pos(tag):
    return {"J": wordnet.ADJ, "V": wordnet.VERB, "N": wordnet.NOUN, "R": wordnet.ADV}.get(tag[0], wordnet.NOUN)

# POS-tag each ticket in context; keep the most common tag per final token
tags = defaultdict(Counter)
final_all = []
for text in df.Ticket_Text:
    p = process_ticket(text)
    keep = set(p["final"])
    for tok, tag in nltk.pos_tag(p["tokens"]):
        if tok in keep:
            tags[tok][tag] += 1
    final_all += p["final"]

unique_final = sorted(set(final_all))

rows = []
for w in unique_final:
    tag = tags[w].most_common(1)[0][0]
    rows.append({"Token": w, "POS": tag,
                 "Porter": porter.stem(w),
                 "Lancaster": lancaster.stem(w),
                 "Regexp": regex.stem(w),
                 "Lemma": lemmatizer.lemmatize(w, wn_pos(tag))})

res = pd.DataFrame(rows)
diff = res[res[["Porter", "Lancaster", "Regexp", "Lemma"]].nunique(axis=1) > 1]

print(f"Unique final tokens: {len(res)}   Tokens where outputs differ: {len(diff)}\n")
print(diff.to_string(index=False))
res.to_csv(f"{ROLL_NO}_Q4_all.csv", index=False)
