Q2.import re

# ---------- extraction patterns ----------
# words longer than 5 letters (the lookahead stops "couldn't" matching as "couldn")
LONG_WORD   = re.compile(r"\b[A-Za-z]{6,}\b(?!['’])")

# numbers: hex (0x80070005), thousands (1,000), decimals / dotted versions (95.5, 2.0.1), integers
NUMBER      = re.compile(r"\b0[xX][0-9A-Fa-f]+\b"
                         r"|(?<![A-Za-z0-9])\d{1,3}(?:,\d{3})+(?:\.\d+)?"
                         r"|(?<![A-Za-z0-9])\d+(?:\.\d+)*")

# capitalized words: Upper + lowercase letters (keeps Isn't / Alice's whole)
CAPITALIZED = re.compile(r"\b[A-Z][a-z]+(?:['’][a-z]+)*\b")

# words starting with a vowel (keeps e-mail, isn't whole)
VOWEL_WORD  = re.compile(r"\b[aeiouAEIOU][A-Za-z]*(?:['’\-][A-Za-z]+)*\b")

# ---------- masking patterns ----------
EMAIL = re.compile(r"[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}")
URL   = re.compile(r"(?:https?://|www\.)[^\s<>\"']*[^\s<>\"'.,;:!?)\]]")   # last char can't be punctuation
PHONE = re.compile(r"(?<![\w.+\-])(?:\+\d{1,3}[\s\-]?)?"
                   r"(?:\d{5}[\s\-]?\d{5}"                                 # mobile: 98765 43210, +91 98765 43210
                   r"|\(?0\d{2,4}\)?[\s\-]?\d{3}[\s\-]?\d{3,4})(?!\w)")    # landline: 0175-239-3201

def extract_all(text):
    return {
        "long_words":  LONG_WORD.findall(text),
        "numbers":     NUMBER.findall(text),
        "capitalized": CAPITALIZED.findall(text),
        "vowel_words": VOWEL_WORD.findall(text),
    }

def mask(text):
    text = EMAIL.sub("<EMAIL>", text)   # email first, so the domain isn't read as a URL
    text = URL.sub("<URL>", text)
    text = PHONE.sub("<PHONE>", text)
    return text

for tid, text in zip(df.Ticket_ID, df.Ticket_Text):
    print(tid, "|", text)
    for name, found in extract_all(text).items():
        print(f"   {name:12}", found)
    print("   masked      ", mask(text), "\n");
